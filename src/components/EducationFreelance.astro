---
import type { SiteContent } from '../i18n/types';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="education" class="mx-auto max-w-4xl px-6 pb-20">
	<div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
		<div>
			<h2 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-muted);">
				{t.sectionLabels.education}
			</h2>
			<div class="mt-6">
				<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
					<h3 class="text-base font-semibold" style="color: var(--text-primary);">
						{t.education.school} · {t.education.degree}
					</h3>
				</div>
				<p class="text-sm" style="color: var(--text-muted);">
					{t.education.period}
				</p>
				<ul class="mt-3 space-y-1.5 text-sm leading-relaxed" style="color: var(--text-secondary);">
					{t.education.notes.map((n) => (
						<li class="flex gap-2">
							<span aria-hidden="true" style="color: var(--text-muted);">
								·
							</span>
							<span>{n}</span>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div>
			<h2 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-muted);">
				{t.sectionLabels.freelance}
			</h2>
			<div class="mt-6 space-y-6">
				{
					t.freelanceProjects.map((proj) => (
						<div>
							<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
								<h3 class="text-base font-semibold" style="color: var(--text-primary);">
									{proj.title}
								</h3>
							</div>
							<p class="text-sm" style="color: var(--text-muted);">
								{proj.period}
							</p>
							<ul class="mt-2 space-y-1 text-sm leading-relaxed" style="color: var(--text-secondary);">
								{proj.points.map((p) => (
									<li class="flex gap-2">
										<span aria-hidden="true" style="color: var(--text-muted);">
											·
										</span>
										<span>{p}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
