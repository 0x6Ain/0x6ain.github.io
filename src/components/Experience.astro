---
import type { SiteContent } from '../i18n/types';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="experience" class="mx-auto max-w-4xl px-6 pb-20">
	<h2 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-muted);">
		{t.sectionLabels.experience}
	</h2>
	<div class="mt-6 space-y-10">
		{
			t.experiences.map((exp) => (
				<article class="border-l-2 pl-6" style="border-color: var(--border);">
					<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
						<h3 class="text-lg font-semibold" style="color: var(--text-primary);">
							{exp.company}
						</h3>
						<span class="text-sm" style="color: var(--text-muted);">
							{exp.period}
						</span>
					</div>
					<p class="mt-1 text-sm" style="color: var(--accent);">
						{exp.role} · {exp.summary}
					</p>
					<ul class="mt-3 space-y-1.5 text-sm leading-relaxed" style="color: var(--text-secondary);">
						{exp.highlights.map((h) => (
							<li class="flex gap-2">
								<span aria-hidden="true" style="color: var(--text-muted);">
									·
								</span>
								<span>{h}</span>
							</li>
						))}
					</ul>
					<div class="mt-3 flex flex-wrap gap-2">
						{exp.stack.map((s) => (
							<span
								class="rounded-full px-3 py-1 text-xs"
								style="background: var(--accent-soft); color: var(--accent-strong);"
							>
								{s}
							</span>
						))}
					</div>
				</article>
			))
		}

		<article class="border-l-2 pl-6" style="border-color: var(--border);">
			<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
				<h3 class="text-lg font-semibold" style="color: var(--text-primary);">
					{t.sideProject.title}
				</h3>
				<span class="text-sm" style="color: var(--text-muted);">
					{t.sideProject.period}
				</span>
			</div>
			<p class="mt-1 text-sm" style="color: var(--accent);">
				{t.sideProject.role}
			</p>
			<ul class="mt-3 space-y-1.5 text-sm leading-relaxed" style="color: var(--text-secondary);">
				{t.sideProject.highlights.map((h) => (
					<li class="flex gap-2">
						<span aria-hidden="true" style="color: var(--text-muted);">
							·
						</span>
						<span>{h}</span>
					</li>
				))}
			</ul>
			<div class="mt-3 flex flex-wrap gap-2 text-xs" style="color: var(--good);">
				{t.sideProject.achievements.map((a) => (
					<span class="rounded-full px-3 py-1" style="background: var(--good-soft);">
						{a}
					</span>
				))}
			</div>
			<div class="mt-2 flex flex-wrap gap-2">
				{t.sideProject.stack.map((s) => (
					<span
						class="rounded-full px-3 py-1 text-xs"
						style="background: var(--accent-soft); color: var(--accent-strong);"
					>
						{s}
					</span>
				))}
			</div>
		</article>
	</div>
</section>
