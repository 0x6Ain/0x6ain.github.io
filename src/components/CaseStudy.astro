---
import { pathForLang, type Lang } from '../i18n';
import type { SiteContent } from '../i18n/types';

interface Props {
  t: SiteContent;
  lang: Lang;
}

const { t, lang } = Astro.props;
---

<section id="case-studies" class="mx-auto max-w-4xl px-6 pb-20">
	<div class="flex items-baseline justify-between gap-4">
		<h2 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-muted);">
			{t.sectionLabels.caseStudy}
		</h2>
		<a
			href={`${pathForLang(lang)}case-studies/`}
			class="shrink-0 text-sm font-medium transition-colors hover:opacity-70"
			style="color: var(--accent);"
		>
			{t.caseStudiesPage.viewAll} →
		</a>
	</div>

	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
		{
			t.caseStudies.map((caseStudy) => (
				<a
					href={`${pathForLang(lang)}case-studies/${caseStudy.slug}/`}
					class="block rounded-2xl border p-6 transition-colors hover:opacity-90"
					style="background: var(--surface); border-color: var(--border);"
				>
					<span
						class="text-xs font-semibold tracking-wide uppercase"
						style="color: var(--text-muted);"
					>
						{caseStudy.company}
					</span>
					<h3 class="mt-2 text-lg font-semibold" style="color: var(--text-primary);">
						{caseStudy.title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary);">
						{caseStudy.summary}
					</p>
					<div class="mt-4 flex flex-wrap gap-2">
						{caseStudy.tags.map((tag) => (
							<span
								class="rounded-full px-2.5 py-1 text-xs"
								style="background: var(--accent-soft); color: var(--accent-strong);"
							>
								{tag}
							</span>
						))}
					</div>
				</a>
			))
		}
	</div>
</section>
