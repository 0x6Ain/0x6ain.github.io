---
import type { SiteContent } from '../i18n/types';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const caseStudy = t.caseStudy;
---

<section id="case-study" class="mx-auto max-w-4xl px-6 pb-20">
	<h2 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-muted);">
		{t.sectionLabels.caseStudy} — {caseStudy.company}
	</h2>
	<h3 class="mt-3 text-2xl font-semibold" style="color: var(--text-primary);">
		{caseStudy.title}
	</h3>
	<p class="mt-2 text-base" style="color: var(--text-secondary);">
		{caseStudy.subtitle}
	</p>

	<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
		{
			caseStudy.steps.map((step) => (
				<div
					class="rounded-2xl border p-6"
					style="background: var(--surface); border-color: var(--border);"
				>
					<span
						class="text-xs font-semibold tracking-wide uppercase"
						style="color: var(--accent);"
					>
						{step.label}
					</span>
					<p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary);">
						{step.body}
					</p>
				</div>
			))
		}
	</div>
</section>
