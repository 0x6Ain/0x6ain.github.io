---
import type { SiteContent } from '../i18n/types';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="skills" class="mx-auto max-w-4xl px-6 pb-20">
	<h2 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-muted);">
		{t.sectionLabels.skills}
	</h2>
	<div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
		{
			t.skillGroups.map((group) => (
				<div
					class="rounded-2xl border p-6"
					style="background: var(--surface); border-color: var(--border);"
				>
					<h3 class="text-base font-semibold" style="color: var(--text-primary);">
						{group.title}
					</h3>
					<ul class="mt-3 space-y-1.5 text-sm leading-relaxed" style="color: var(--text-secondary);">
						{group.items.map((item) => (
							<li class="flex gap-2">
								<span aria-hidden="true" style="color: var(--accent);">
									·
								</span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>
